# Environment variables template.
#
# This file is tracked by git and must NEVER contain real values.
# To use it locally: copy it to .env and fill in your own values.
#
#   cp .env.example .env
#
# Rules:
# - Every new variable is added here, with a placeholder value, in the same
#   commit that starts using it.
# - Development uses test credentials only (Stripe test mode, Meta test number).
# - Production secrets live in the hosting platform's secret manager.

# --- Local services (docker-compose.yml) ---
# Generate each password with: openssl rand -hex 24
POSTGRES_USER=manos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=manos
REDIS_PASSWORD=change-me
# --- API (apps/api) ---
NODE_ENV=dev
PORT=5000
LOG_LEVEL=info
# PostgreSQL connection URL. The user, password and database must match POSTGRES_* above.
# Use 127.0.0.1, not localhost: the compose file publishes the port on IPv4 only.
DATABASE_URL=postgresql://manos:change-me@127.0.0.1:5432/manos
# URL of the database used by the integration tests. The name must end in _test:
# the tests empty its tables
TEST_DATABASE_URL=postgresql://manos:change-me@127.0.0.1:5432/manos_test
